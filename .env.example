# ─────────────────────────────────────────────────────────────
# AI-INFLUENCER-OS — Environment Variables Template
# Copy this file to .env and fill in your details:
# copy .env.example .env
# ─────────────────────────────────────────────────────────────

# 1. Google Gemini API (Free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot (Free: Search @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id_here

# 3. Instagram Account (Optional for auto-posting)
IG_USERNAME=your_instagram_handle
IG_PASSWORD=your_instagram_password

# 4. Free Cloud GPU Compute (Kaggle or Hugging Face)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
HF_TOKEN=your_huggingface_token

# 5. Model Paths (Default pre-configured)
LORA_PATH=models/lora/my_face.safetensors
VOICE_REF=models/voice/reference.wav
